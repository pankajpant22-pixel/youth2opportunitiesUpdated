---
import { PortableText } from "astro-portabletext";
import Base from "../../layouts/Base.astro";
import Reveal from "../../components/Reveal.astro";
import PostCard from "../../components/PostCard.astro";
import PortableTextImage from "../../components/PortableTextImage.astro";
import PortableTextLink from "../../components/PortableTextLink.astro";
import PortableTextFaq from "../../components/PortableTextFaq.astro";
import PortableTextCallout from "../../components/PortableTextCallout.astro";
import PortableTextTable from "../../components/PortableTextTable.astro";
import {
  getPosts,
  metaDescription,
  formatDate,
  relatedPosts,
  sized,
  postHref,
  authorHref,
  categoryHref,
  type Post,
} from "../../sanity/posts";
import { ORG_NAME, LOGO, absolute, breadcrumbs } from "../../site";
import "../../styles/base.css";
import "../../styles/pages/blog.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const site = Astro.site;
// The meta title is used as written; the post title gets the site suffix.
const title = post.seo?.metaTitle || `${post.title} · Y2O`;
const description = metaDescription(post);
// Only show "Last updated" when it's a later day than the publish date.
const updated = post.updatedAt && formatDate(post.updatedAt) !== formatDate(post.publishedAt) ? post.updatedAt : null;
const cover = post.image && sized(post.image, 1400);
const shareSource = post.seo?.ogImage ?? post.image?.url;
const shareImage = shareSource ? `${shareSource}?w=1200&h=630&fit=crop&auto=format` : undefined;
const url = absolute(postHref(post.slug), site);
const category = post.categories[0];
const related = relatedPosts(post, posts);

const faqItems = post.body
  .filter((b) => b._type === "faq")
  .flatMap((b: any) => b.items ?? [])
  .filter((i: { question?: string; answer?: string }) => i.question && i.answer);

const schema: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description,
    url,
    mainEntityOfPage: url,
    ...(shareImage && { image: shareImage }),
    ...(post.publishedAt && { datePublished: post.publishedAt }),
    ...((post.updatedAt ?? post.publishedAt) && { dateModified: post.updatedAt ?? post.publishedAt }),
    ...(post.author && {
      author: {
        "@type": "Person",
        name: post.author.name,
        ...(post.author.role && { jobTitle: post.author.role }),
        ...(post.author.slug && { url: absolute(authorHref(post.author.slug), site) }),
        ...(post.author.links?.length && { sameAs: post.author.links }),
      },
    }),
    publisher: { "@type": "Organization", name: ORG_NAME, logo: { "@type": "ImageObject", url: absolute(LOGO, site) } },
  },
  breadcrumbs(
    [
      { name: "Blog", path: "/blog" },
      ...(category ? [{ name: category.title, path: categoryHref(category.slug) }] : []),
      { name: post.title, path: postHref(post.slug) },
    ],
    site,
  ),
  ...(faqItems.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqItems.map((i: { question: string; answer: string }) => ({
            "@type": "Question",
            name: i.question,
            acceptedAnswer: { "@type": "Answer", text: i.answer },
          })),
        },
      ]
    : []),
];
---

<Base
  title={title}
  description={description}
  current="/blog"
  type="article"
  canonical={post.seo?.canonicalUrl}
  image={shareImage}
  noindex={post.seo?.noIndex}
  schema={schema}
>
  <article class="article">
    <header class="wrap article-head">
      <nav class="back" aria-label="Breadcrumb">
        <a href="/blog">Blog</a>{category && <> / <a href={categoryHref(category.slug)}>{category.title}</a></>}
      </nav>
      <h1>{post.title}</h1>
      <p class="meta">
        <time datetime={post.publishedAt ?? undefined}>{formatDate(post.publishedAt)}</time>
        {
          post.author && (
            <span>
              {" "}
              · {post.author.slug ? <a href={authorHref(post.author.slug)}>{post.author.name}</a> : post.author.name}
            </span>
          )
        }
        {updated && <span> · Last updated <time datetime={updated}>{formatDate(updated)}</time></span>}
      </p>
    </header>
    {
      cover && (
        <img
          class="article-cover"
          src={cover.src}
          width={cover.width}
          height={cover.height}
          alt={post.image?.alt ?? ""}
          fetchpriority="high"
        />
      )
    }
    <div class="wrap prose">
      <PortableText
        value={post.body}
        components={{
          type: { image: PortableTextImage, faq: PortableTextFaq, callout: PortableTextCallout, table: PortableTextTable },
          mark: { link: PortableTextLink, internalLink: PortableTextLink },
        }}
      />

      <aside class="post-cta">
        <h2>Turn what you do into a record that counts</h2>
        <p>Log activities, get them confirmed by people who saw the work, and see where you stand.</p>
        <div class="acts">
          <a class="btn btn-primary" href="/contact">Create your account</a>
          <a class="btn btn-ghost" href="/score">See your score</a>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="sec related">
        <div class="wrap">
          <h2>Related posts</h2>
          <div class="posts">
            {related.map((p) => <PostCard post={p} heading="h3" />)}
          </div>
        </div>
      </section>
    )
  }

  <Reveal slot="scripts" />
</Base>
