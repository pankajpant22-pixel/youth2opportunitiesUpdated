---
import Base from "../layouts/Base.astro";
import Reveal from "../components/Reveal.astro";
import "../styles/pages/parents.css";
---

<Base title={"Parents · Y2O"} description={"See the activities, hours, and skills your teen is building, confirmed by people outside the family. Your teen owns the record and shares it with you."} current="/parents">
<header class="hero">
  <div class="wrap">
    <span class="tag rv">For parents and families</span>
    <h1 class="rv d1">Visibility <em>without hovering</em></h1>
    <div class="motto rv d2">
      <span>Track it</span><span>Verify it</span
      ><span>Carry it forward</span>
    </div>
    <p class="sub rv d2">
      See the activities, hours, and skills your high schooler is building,
      confirmed by people outside the family. The record stays with them.
      You see what they choose to share.
    </p>
    <div class="actions rv d3">
      <a class="btn btn-primary" href="contact.html"
        >Get your teen started</a
      ><a class="btn btn-ghost" href="#families">How families fit in</a>
    </div>
  </div>
  <div class="wrap stage">
    <div class="product" id="product">
      <div class="panel">
        <div class="ptop">
          <div class="who">
            <div class="av">Y</div>
            <div>
              <b>Your Teen · This Term</b><span>Grade 11 · Ontario</span>
            </div>
          </div>
          <span class="chip">Shared With You</span>
        </div>
        <div class="snap">
          <div class="snap-l">
            <h4>Progress this term</h4>
            <div class="prog">
              <div>
                <b>62h</b><span>Hours logged</span
                ><em>+18h vs last term</em>
              </div>
              <div>
                <b>3</b><span>New activities</span
                ><em>2 already verified</em>
              </div>
            </div>
            <div class="req">
              <div class="rt">
                <b>Ontario 40-hour requirement</b><span>40 / 40h</span>
              </div>
              <div class="tr"><em data-w="100"></em></div>
              <span class="ok"
                ><svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 12l2 2 4-4" />
                  <circle cx="12" cy="12" r="10" /></svg
                >Requirement met</span
              >
            </div>
          </div>
          <div class="snap-r">
            <h4>New this week</h4>
            <div class="act">
              <div class="ic">
                <svg
                  width="19"
                  height="19"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
              </div>
              <div>
                <b>Reading buddy session</b
                ><small>3h · Oakville Public Library</small>
              </div>
              <span class="st ok">Verified</span>
            </div>
            <div class="act">
              <div class="ic">
                <svg
                  width="19"
                  height="19"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" />
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                </svg>
              </div>
              <div><b>Saturday shift</b><small>6h · Café Rosa</small></div>
              <span class="st ok">Verified</span>
            </div>
            <div class="act">
              <div class="ic">
                <svg
                  width="19"
                  height="19"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="8" r="6" />
                  <path d="M15.5 13 17 22l-5-3-5 3 1.5-9" />
                </svg>
              </div>
              <div>
                <b>Math competition</b><small>Awaiting Mr Patel</small>
              </div>
              <span class="st wait">In review</span>
            </div>
          </div>
        </div>
        <div class="ro">
          <span>Read-only · shared by your teen · not surveillance</span
          ><span
            ><svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg
            >Private</span
          >
        </div>
      </div>
    </div>
  </div>
</header>

<section class="sec dark">
  <div class="wrap">
    <div class="head rv">
      <span class="tag on-dark">Why now</span>
      <h2 class="h2">Why this matters before Grade 12</h2>
      <p class="lead">
        Grades alone no longer separate strong students. The record now has
        to do that.
      </p>
    </div>
    <div class="three">
      <div class="chg rv">
        <div class="big">87<em>%</em></div>
        <h4>UBC average entrance grade</h4>
        <p>Up from 70% twenty years ago.</p>
        <a
          href="https://www.fraserinstitute.org/commentary/grade-inflation-gives-students-false-sense-of-their-academic-abilities"
          target="_blank"
          rel="noopener"
          >Fraser Institute, 2024</a
        >
      </div>
      <div class="chg rv d1">
        <div class="big">39<em>%</em></div>
        <h4>Of core skills will change</h4>
        <p>Workers' core skills expected to change by 2030.</p>
        <a
          href="https://www.weforum.org/publications/the-future-of-jobs-report-2025/"
          target="_blank"
          rel="noopener"
          >World Economic Forum, 2025</a
        >
      </div>
      <div class="chg rv d2">
        <div class="big">40<em>h</em></div>
        <h4>Community involvement</h4>
        <p>Required to graduate high school in Ontario.</p>
        <a
          href="https://www.ontario.ca/page/get-your-high-school-volunteer-hours"
          target="_blank"
          rel="noopener"
          >Ontario Ministry of Education</a
        >
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="head rv">
      <span class="tag">Parent clarity</span>
      <h2 class="h2">The record gets messy fast. This fixes that.</h2>
      <p class="lead">
        Forms, screenshots, and hours pile up at home. Y2O keeps them in one
        place.
      </p>
    </div>
    <div class="simple">
      <div class="si rv">
        <div class="ic">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        </div>
        <h4>No paper forms</h4>
        <p>Confirmations live in the record.</p>
      </div>
      <div class="si rv d1">
        <div class="ic">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 6v6l4 2" />
          </svg>
        </div>
        <h4>No guesswork</h4>
        <p>Logged as it happens.</p>
      </div>
      <div class="si rv d2">
        <div class="ic">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h4>No Grade 12 panic</h4>
        <p>Ready before deadlines.</p>
      </div>
      <div class="si rv d3">
        <div class="ic">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
            <path d="m16 6-4-4-4 4" />
            <path d="M12 2v13" />
          </svg>
        </div>
        <h4>Ready to share</h4>
        <p>One link or one PDF.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec soft">
  <div class="wrap">
    <div class="head rv">
      <span class="tag">Grade 9 to 12</span>
      <h2 class="h2">Your teen's record across four years</h2>
      <p class="lead">
        Built a little every year, not in a panic in Grade 12.
      </p>
    </div>
    <div class="years">
      <div class="yr rv">
        <div class="dot">9</div>
        <div class="card">
          <h4>Grade 9</h4>
          <div class="row"><span>Activities</span><b>3</b></div>
          <div class="row"><span>Hours</span><b>22h</b></div>
          <div class="row"><span>Verified</span><b>3 of 3</b></div>
          <div class="row"><span>Growth Score</span><b>38</b></div>
          <p>First volunteer hours, a school club, first confirmation.</p>
        </div>
      </div>
      <div class="yr rv d1">
        <div class="dot">10</div>
        <div class="card">
          <h4>Grade 10</h4>
          <div class="row"><span>Activities</span><b>5</b></div>
          <div class="row"><span>Hours</span><b>58h</b></div>
          <div class="row"><span>Verified</span><b>5 of 5</b></div>
          <div class="row"><span>Growth Score</span><b>52</b></div>
          <p>Ontario 40 hours cleared, first summer job, robotics.</p>
        </div>
      </div>
      <div class="yr now rv d2">
        <div class="dot">11</div>
        <div class="card">
          <h4>Grade 11 <small>Now</small></h4>
          <div class="row"><span>Activities</span><b>8</b></div>
          <div class="row"><span>Hours</span><b>103h</b></div>
          <div class="row"><span>Verified</span><b>5 of 6</b></div>
          <div class="row"><span>Growth Score</span><b>67</b></div>
          <p>Build lead role, steady weekly activity.</p>
        </div>
      </div>
      <div class="yr rv d3">
        <div class="dot">12</div>
        <div class="card">
          <h4>Grade 12</h4>
          <div class="row"><span>Activities</span><b>Growing</b></div>
          <div class="row"><span>Hours</span><b>160h+</b></div>
          <div class="row"><span>Verified</span><b>In progress</b></div>
          <div class="row"><span>Growth Score</span><b>Target 78</b></div>
          <p>Applications open, record ready to share.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="families">
  <div class="wrap">
    <div class="head rv">
      <span class="tag">For families</span>
      <h2 class="h2">How families fit in</h2>
      <p class="lead">
        Your teen stays in charge. You get a link, no sign-up needed.
      </p>
    </div>
    <div class="steps4">
      <div class="sc rv">
        <div class="ic">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        </div>
        <span class="lb">Step 1</span>
        <h4>Your teen invites you</h4>
        <p>You get a link. Read-only.</p>
      </div>
      <div class="sc rv d1">
        <div class="ic">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <span class="lb">Step 2</span>
        <h4>You see what they share</h4>
        <p>Hours, activities, what's verified.</p>
      </div>
      <div class="sc rv d2">
        <div class="ic">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="m16 11 2 2 4-4" />
          </svg>
        </div>
        <span class="lb">Step 3</span>
        <h4>You can confirm too</h4>
        <p>If you saw the work yourself.</p>
      </div>
      <div class="sc rv d3">
        <div class="ic">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
            <path d="M9 22V12h6v10" />
          </svg>
        </div>
        <span class="lb">Step 4</span>
        <h4>The record stays theirs</h4>
        <p>They carry it past graduation.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec soft">
  <div class="wrap priv">
    <div class="rv">
      <span class="tag">Privacy by default</span>
      <h2 class="h2">Your teen stays in charge</h2>
      <p class="lead">Visibility, never surveillance.</p>
    </div>
    <div class="plist">
      <div class="prow rv">
        <div class="ic">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <div>
          <h4>Student-owned</h4>
          <p>Your teen owns the record and can stop sharing any time.</p>
        </div>
      </div>
      <div class="prow rv d1">
        <div class="ic">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"
            />
          </svg>
        </div>
        <div>
          <h4>They choose what you see</h4>
          <p>Full profile, this term, or just verified hours.</p>
        </div>
      </div>
      <div class="prow rv d2">
        <div class="ic">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"
            />
            <path d="M2 21c0-3 1.9-5.4 5.1-6" />
          </svg>
        </div>
        <div>
          <h4>Canadian data</h4>
          <p>Stored in Canada, following PIPEDA.</p>
        </div>
      </div>
      <div class="prow rv d3">
        <div class="ic">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          </svg>
        </div>
        <div>
          <h4>No ads, never sold</h4>
          <p>Student data is never sold.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap faq">
    <div class="rv">
      <span class="tag">FAQ</span>
      <h2 class="h2">Questions families ask</h2>
      <p class="lead" style="font-size: 18px">
        Still wondering?
        <a
          href="mailto:info@youth2opportunities.ca"
          style="color: var(--maroon); font-weight: 700"
          >info@youth2opportunities.ca</a
        >
      </p>
    </div>
    <div class="qa rv d1">
      <details open>
        <summary>
          Do I need to create an account?<span class="pl">+</span>
        </summary>
        <p>
          No. Your teen sends you a secure link to their record. Open it and
          you're in.
        </p>
      </details>
      <details>
        <summary>
          Can I edit my teen's record?<span class="pl">+</span>
        </summary>
        <p>
          No. The family view is read-only. Only your teen adds or removes
          activities, which keeps the record credible.
        </p>
      </details>
      <details>
        <summary>
          Is it only about the 40 volunteer hours?<span class="pl">+</span>
        </summary>
        <p>
          No. The 40 hours are part of it, but Y2O covers jobs, sports,
          clubs, caregiving, and everything else your teen puts effort into.
        </p>
      </details>
      <details>
        <summary>
          What if my teen hasn't done much yet?<span class="pl">+</span>
        </summary>
        <p>
          That's the best time to start. Seeing the record early helps them
          choose what to try next.
        </p>
      </details>
      <details>
        <summary>Is my teen's data sold?<span class="pl">+</span></summary>
        <p>No. Student data is never sold.</p>
      </details>
    </div>
  </div>
</section>

<section style="padding: 0 0 40px">
  <div class="wrap">
    <div class="cta rv">
      <div>
        <span class="tag on-dark">Help your teen start</span>
        <h2>Start before the record is needed</h2>
        <p>Your teen signs up. You get a link.</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="contact.html"
          >Get your teen started</a
        ><a class="btn btn-line-light" href="students.html"
          >See the student side</a
        >
      </div>
    </div>
  </div>
</section>
  <Reveal slot="scripts" />
</Base>
