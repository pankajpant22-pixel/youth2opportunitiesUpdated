        };
        var C = [
          ["work", "Work", "Part-time jobs, shifts, paid roles."],
          ["vol", "Volunteering", "Service hours, events, community support."],
          ["club", "Clubs", "School clubs, teams, leadership roles."],
          [
            "sport",
            "Sports and competitions",
            "Training, tournaments, challenges.",
          ],
          [
            "side",
            "Side projects",
            "Personal projects, creative work, ventures.",
          ],
          ["comm", "Community", "Local involvement and contribution."],
          ["skill", "Skills", "Practice, learning, certificates."],
          ["more", "More coming", "New activity types as Y2O grows."],
        ];
        document.getElementById("counts").innerHTML = C.map(function (c, i) {
          return (
            '<div class="ct rv d' +
            (i % 4) +
            '"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
            I[c[0]] +
            "</svg></div><h4>" +
