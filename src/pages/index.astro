              var t = setInterval(function () {
                el.textContent = ++n;
                if (n >= 67) clearInterval(t);
              }, 22);
            }
            setTimeout(
              function () {
                document.getElementById("f1").classList.add("on");
              },
              reduce ? 0 : 1300,
