<!-- Scroll reveal, product tilt and bar animations shared by most pages. -->
<script is:inline>
  (function () {
    var reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    var io = new IntersectionObserver(
      function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
    );
    document.querySelectorAll(".rv").forEach(function (el) {
      io.observe(el);
    });
    var p = document.getElementById("product");
    if (p) {
      function tilt() {
        var r = p.getBoundingClientRect(),
          vh = innerHeight,
          t = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.75)));
        p.style.transform =
          "rotateX(" +
          16 * (1 - t) +
          "deg) scale(" +
          (0.95 + 0.05 * t) +
          ")";
      }
      if (!reduce) {
        tilt();
        addEventListener("scroll", tilt, { passive: true });
        addEventListener("resize", tilt);
      } else {
        p.style.transform = "none";
      }
      new IntersectionObserver(
        function (es, o) {
          if (!es[0].isIntersecting) return;
          o.disconnect();
          document.querySelectorAll("[data-w]").forEach(function (e) {
            e.style.width = e.dataset.w + "%";
          });
          document.querySelectorAll("[data-delay]").forEach(function (e) {
            setTimeout(
              function () {
                e.classList.add("on");
              },
              reduce ? 0 : +e.dataset.delay,
            );
          });
        },
        { threshold: 0.3 },
      ).observe(p);
    }
    document.querySelectorAll("[data-wv]").forEach(function (e) {
      new IntersectionObserver(
        function (es, o) {
          if (es[0].isIntersecting) {
            e.style.width = e.dataset.wv + "%";
            o.disconnect();
          }
        },
        { threshold: 0.4 },
      ).observe(e);
    });
  })();
</script>
