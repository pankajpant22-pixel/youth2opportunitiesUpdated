# Sanity (project settings: https://www.sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Only needed if the dataset is private. Viewer token; read at build time, never sent to the browser.
SANITY_API_READ_TOKEN=

# SEO and analytics (all optional; each tag is left out when its value is empty)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Also enables cta_click conversion events.
PUBLIC_GA_ID=
# The content="" value of the Google Search Console HTML-tag verification.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# The content="" value of the Bing Webmaster Tools msvalidate.01 meta tag.
PUBLIC_BING_SITE_VERIFICATION=
